<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.dyscidio"
       name="Dyscidio"
       version="1.0.7"
       provider-name="Dyscidio">

    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <extension point="xbmc.python.pluginsource"
               library="main.py">
        <provides>video</provides>
    </extension>

    <extension point="xbmc.addon.metadata">
        <summary>Enlaces personales de Dyscidio</summary>
        <description>Addon personal para acceder rápidamente a una selección de enlaces.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>

</addon>